{% comment %}
  Custom 404 section, used by templates/404.json.

  Every value below comes from section.settings, which the merchant edits in
  the theme editor. The defaults live in the {% schema %} at the bottom, and
  templates/404.json can override them.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/404
{% endcomment %}

<div
  class="not-found"
  style="--alignment: {{ section.settings.alignment }}"
>
  {% if section.settings.image %}
    {% render 'image',
      image: section.settings.image,
      class: 'not-found__image',
      width: 800
    %}
  {% endif %}

  {% if section.settings.heading != blank %}
    <h1 class="not-found__heading">{{ section.settings.heading | escape }}</h1>
  {% endif %}

  {% if section.settings.message != blank %}
    <p class="not-found__message">{{ section.settings.message | escape }}</p>
  {% endif %}

  {% if section.settings.button_label != blank %}
    <a class="not-found__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
      {{ section.settings.button_label | escape }}
    </a>
  {% endif %}
</div>

{% stylesheet %}
  .not-found {
    display: grid;
    gap: 1.5rem;
    justify-items: var(--alignment);
    text-align: var(--alignment);
    padding: 4rem 1rem;
  }

  .not-found__image {
    max-width: 24rem;
  }

  .not-found__heading {
    font-size: 2.5rem;
    font-weight: 700;
  }

  .not-found__button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border: 1px solid currentColor;
    text-decoration: none;
  }

  .not-found__button:hover {
    opacity: 0.7;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.custom_404",
  "enabled_on": {
    "templates": ["404"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Page not found"
    },
    {
      "type": "text",
      "id": "message",
      "label": "t:labels.message",
      "default": "Sorry, the page you're looking for doesn't exist."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Back to shopping"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link",
      "default": "/collections/all"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:labels.alignment",
      "default": "center"
    }
  ]
}
{% endschema %}
